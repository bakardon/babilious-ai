# Copy to .env to override defaults. Everything here is optional.
# No API keys are needed: Babilious runs entirely locally.

# Where the web UI listens (keep 127.0.0.1 so only this PC can reach it)
BABILIOUS_HOST=127.0.0.1
BABILIOUS_PORT=5000

# Local Ollama server
OLLAMA_HOST_URL=http://127.0.0.1:11434

# Model used on first run (can be changed later in Settings > Models)
BABILIOUS_DEFAULT_MODEL=llama3.2:latest

# DEBUG, INFO, WARNING
BABILIOUS_LOG_LEVEL=INFO

# Optional: custom database location
# BABILIOUS_DB=C:\path\to\babilious.db
